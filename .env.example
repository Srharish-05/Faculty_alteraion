# FacultySync Environment Configuration
# Copy this file to .env and fill in your values

# ==================== SERVER CONFIGURATION ====================
PORT=5000
NODE_ENV=development

# ==================== DATABASE ====================
MONGODB_URI=mongodb+srv://username:password@your-cluster.mongodb.net/faculty_db?retryWrites=true&w=majority&appName=Faculty
DATABASE_NAME=faculty_db

# ==================== SECURITY ====================
# Change this to a secure random string in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-78945612365

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000

# ==================== ADMIN ACCOUNT ====================
# Used for initial setup and bulk faculty creation
# IMPORTANT: Change these immediately in production!
ADMIN_EMAIL=admin@mkce.ac.in
ADMIN_PASSWORD=YourSecureAdminPassword123!

# ==================== FACULTY CREATION ====================
# Password to set for newly created faculty accounts
# Must be 12+ characters with uppercase, lowercase, number, and special character
INITIAL_FACULTY_PASSWORD=InitialFacultyPassword123!

# ==================== LOGGING ====================
LOG_LEVEL=info

# ==================== API CONFIGURATION ====================
# URL where frontend can reach the API
API_URL=http://localhost:5000

# ==================== FILE STORAGE ====================
# Path to store JSON data files (before MongoDB migration)
DATA_DIR=./data

# ==================== DEVELOPMENT ====================
# Set to true to enable detailed error messages
DEBUG=false
