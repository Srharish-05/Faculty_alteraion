MONGODB_URI=mongodb+srv://username:password@your-cluster.mongodb.net/?appName=Faculty
NODE_ENV=development
PORT=5000
DATABASE_NAME=faculty_db

# Render keep-alive options
ENABLE_SELF_PING=false
KEEP_ALIVE_URL=
# 14 minutes by default (Render free services sleep after inactivity)
SELF_PING_INTERVAL_MS=840000
